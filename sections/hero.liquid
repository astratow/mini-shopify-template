{%  comment  %}
    Hero section
    - Content-first by default
    - Product-aware if product is selected
{% endcomment %}

{%  assign hero_product = section.settingss.product %}

<section class="hero">
    <div class="hero-inner">
        <hero-content>

        </hero-content>
    </div>
</section>
{%  schema  %}
{
    "name": "Hero",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Your main value proposition"
        },
        {
            "type": "textarea",
            "id": "text",
            "label": "Text",
            "default": "Describe your product or brand in one clear sentence."
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Hero image"
        },
        {
            "type": "product",
            "id": "product",
            "label": "Hero product(optional)"
        },
        {
            "type": "text",
            "id": "product_cta_label",
            "label": "Product CTA label",
            "default": "Buy Now"
        },
        {
            "type": "url",
            "id": "cta_link",
            "label": "CTA link (used when no product selected)",
            "default": "Learn more"
        }
    ],
    "presets": [
        {
            "name": "Hero"
        }
    ]
}
{% endschema %}