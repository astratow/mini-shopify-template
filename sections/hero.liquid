{%  comment  %}
    Hero section
    - Content-first by default
    - Product-aware if product is selected
{% endcomment %}

{%  assign hero_product = section.settings.product %}

<section class="hero">
    <div class="hero-inner">
        <div class="hero-content">
            {% if section.settings.heading != blank %}
                <h1>{{ section.settings.heading }}</h1>
            {% endif %}


            {% if section.settings.text != blank %}
                <p class="hero-text">
                {% section.settings.text %}
            </p>
            {% endif %}

            {% if hero_product ! %}
                <div class="hero-product-meta">
                    <p class="hero-price">
                        {{ hero_product.price |  money }}
                    </p>
                </div>
            {% endif %}
        </div>
    </div>

    {% if section.settings.image != blank %}
        <div class="hero-media">
            <img 
            src="{{ section.settings.image | image_url: width: 1200 }}" 
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            />
            </div>
    {% endif %}
</section>
{%  schema  %}
{
    "name": "Hero",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Your main value proposition"
        },
        {
            "type": "textarea",
            "id": "text",
            "label": "Text",
            "default": "Describe your product or brand in one clear sentence."
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Hero image"
        },
        {
            "type": "product",
            "id": "product",
            "label": "Hero product(optional)"
        },
        {
            "type": "text",
            "id": "product_cta_label",
            "label": "Product CTA label",
            "default": "Buy Now"
        },
        {
            "type": "url",
            "id": "cta_link",
            "label": "CTA link (used when no product selected)",
            "default": "Learn more"
        }
    ],
    "presets": [
        {
            "name": "Hero"
        }
    ]
}
{% endschema %}